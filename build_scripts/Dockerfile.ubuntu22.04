FROM ubuntu:22.04

ENV DEBIAN_FRONTEND noninteractive

RUN apt update && apt install software-properties-common -y
RUN apt update && add-apt-repository ppa:deadsnakes/ppa
RUN apt update && apt install \
    curl \
    git \
    libxcb-cursor0 \
    python3.14 \
    python3.14-dev \
    python3.14-venv \
    python3-pip \
    ubuntu-gnome-desktop \
    -y
